# Database (Neon PostgreSQL — usar la connection string "pooled" con sslmode=require)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# NextAuth
# Generar con: openssl rand -base64 32 (usar un valor distinto por entorno, nunca reutilizar el de desarrollo en producción)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Environment
NODE_ENV="development"
