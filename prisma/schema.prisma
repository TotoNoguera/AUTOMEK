// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// FASE 1 — Base y acceso
// ============================================================================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String     // hashed with bcrypt
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userTallers UserTaller[]
  auditLogs   AuditLog[]
  stockMovements StockMovement[]

  @@map("users")
}

model Taller {
  id        String     @id @default(cuid())

  nombre    String     // Nombre del taller
  telefono  String?
  email     String?
  direccion String?
  logo      String?    // URL del logo

  // Stock: si es false (por defecto) no se permite que un movimiento deje el stock de un producto en negativo
  permitirStockNegativo Boolean @default(false)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relaciones — Acceso y gestión
  userTallers UserTaller[]

  // Relaciones — Negocio (Fases 2-5)
  clients     Client[]
  quotes      Quote[]
  workOrders  WorkOrder[]
  schedules   Schedule[]
  payments    Payment[]

  // Relaciones — Caja y finanzas (Fase 6)
  paymentMethods PaymentMethod[]
  cashMovements CashMovement[]
  dailyCloses   DailyClose[]
  clientCredits ClientCredit[]

  // Relaciones — Técnicos (Fase 7)
  technicians Technician[]

  // Relaciones — Costos (Fase 8)
  costs       Cost[]

  // Relaciones — Objetivos (Fase 7)
  goals       Goal[]

  // Vehículos (patente única por taller)
  vehicles    Vehicle[]

  // Auditoría
  auditLogs   AuditLog[]

  // Stock
  products       Product[]
  stockMovements StockMovement[]

  @@map("tallers")
}

model UserTaller {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  role      String     @default("admin") // admin, technician, etc. para futuro
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, tallerId])
  @@map("user_tallers")
}

// ============================================================================
// FASE 2 — Clientes y Vehículos
// ============================================================================

model Client {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  nombre    String
  telefono  String?
  email     String?
  direccion String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  vehicles   Vehicle[]
  quotes     Quote[]
  workOrders WorkOrder[]
  schedules  Schedule[]
  credit     ClientCredit?  // Saldo de cuenta corriente

  @@unique([tallerId, email])
  @@index([tallerId])
  @@map("clients")
}

model Vehicle {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  patente   String     // Patente normalizada (mayúsculas, sin espacios). Única por taller.
  marca     String
  modelo    String
  anio      Int
  kilometraje Int?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  quotes    Quote[]
  workOrders WorkOrder[]
  schedules Schedule[]

  @@unique([tallerId, patente])
  @@index([clientId])
  @@map("vehicles")
}

// ============================================================================
// FASE 3 — Presupuestos
// ============================================================================

enum QuoteStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Quote {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])

  status    QuoteStatus @default(PENDIENTE)
  total     Float      @default(0)

  observaciones String?
  fecha     DateTime   @default(now())

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     QuoteItem[]
  workOrder WorkOrder?  // Relación cuando se convierte a orden

  @@index([tallerId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id        String     @id @default(cuid())
  quoteId   String
  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  // Producto del inventario (opcional: los ítems de texto libre y mano de obra no lo usan)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)

  descripcion String
  cantidad  Decimal    @default(1) @db.Decimal(12, 3)
  precioUnitario Float
  subtotal  Float      // cantidad * precioUnitario

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([productId])
  @@map("quote_items")
}

// ============================================================================
// FASE 4 — Órdenes de Trabajo
// ============================================================================

enum WorkOrderStatus {
  PRESUPUESTA    // Creada desde presupuesto sin aprobar
  APROBADA       // Presupuesto aprobado o directa
  EN_PROCESO     // En reparación
  TERMINADA      // Reparación completada
  ENTREGADA      // Entregada al cliente
}

model WorkOrder {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])

  quoteId   String?    @unique
  quote     Quote?     @relation(fields: [quoteId], references: [id])

  status    WorkOrderStatus @default(APROBADA)
  total     Float      @default(0)

  motivoIngreso String
  diagnostico   String?
  observaciones String?

  kmIngreso  Int?
  kmEgreso   Int?

  fecha     DateTime   @default(now())

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items           WorkOrderItem[]
  payments        Payment[]
  cashMovements   CashMovement[]  // Movimientos de caja asociados
  stockMovements  StockMovement[] // Movimientos de stock asociados

  @@index([tallerId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderItem {
  id        String     @id @default(cuid())
  workOrderId String
  workOrder WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // Producto del inventario (opcional: los ítems de texto libre y mano de obra no lo usan)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)

  descripcion String
  cantidad  Decimal    @default(1) @db.Decimal(12, 3)
  precioUnitario Float
  subtotal  Float

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([productId])
  @@map("work_order_items")
}

// ============================================================================
// FASE 5 — Agenda / Turnos
// ============================================================================

enum ScheduleStatus {
  PENDIENTE      // Turno creado, sin confirmar
  CONFIRMADO     // Turno confirmado con cliente
  EN_ESPERA      // Cliente sin confirmar a tiempo
  CANCELADO      // Cancelado
  COMPLETADO     // Convertido a orden de trabajo
}

model Schedule {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id])

  fecha     DateTime
  hora      String     // Formato HH:mm
  motivo    String
  status    ScheduleStatus @default(PENDIENTE)

  workOrderId String?   @unique

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([vehicleId, fecha, hora])
  @@index([tallerId])
  @@index([fecha])
  @@map("schedules")
}

// ============================================================================
// FASE 6 — Caja y Cobros
// ============================================================================

enum PaymentMethodType {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CUENTA_CORRIENTE
}

enum PaymentStatus {
  PAGADO
  PENDIENTE
  ANULADO
}

model PaymentMethod {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  tipo      PaymentMethodType
  nombre    String     // "Efectivo", "Banco X", "Tarjeta Visa", etc.

  payments  Payment[]

  @@index([tallerId])
  @@map("payment_methods")
}

model Payment {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  workOrderId String
  workOrder WorkOrder  @relation(fields: [workOrderId], references: [id])

  methodId  String
  method    PaymentMethod @relation(fields: [methodId], references: [id])

  monto     Float
  status    PaymentStatus @default(PAGADO)

  numeroComprobante String?
  observaciones String?

  anuladoAt     DateTime?
  anuladoMotivo String?

  fecha     DateTime   @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tallerId])
  @@index([fecha])
  @@map("payments")
}

// ============================================================================
// FASE 6+ — Caja y Movimientos (EGRESOS + INGRESOS)
// ============================================================================

enum CashMovementType {
  INGRESO    // Cobros de órdenes
  EGRESO     // Gastos operacionales
}

enum CashMovementCategory {
  // Ingresos
  PAGO_ORDEN
  ANTICIPO

  // Egresos - Gastos operacionales
  COMPRA_REPUESTOS
  COMPRA_MATERIALES
  GASTO_SERVICIOS
  GASTO_MANTENIMIENTO
  GASTO_SUELDOS
  GASTO_ALQUILER
  GASTO_SERVICIOS_UTILES
  GASTO_IMPUESTOS
  GASTO_OTROS

  // Costos operacionales diarios
  COSTO_FIJO_DIARIO
  COSTO_VARIABLE_DIARIO

  // Contrapartida contable de una anulación (monto negativo, referencia al movimiento original)
  REVERSION
}

model CashMovement {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  tipo      CashMovementType
  categoria CashMovementCategory

  monto     Float
  descripcion String?

  // Relación opcional a orden (si es pago de orden)
  workOrderId String?
  workOrder WorkOrder?  @relation(fields: [workOrderId], references: [id])

  // Relación opcional a payment (si es registrado como pago)
  paymentId String?

  // Cliente cuya cuenta corriente afecta (pago de deuda)
  clientId  String?

  // Anulación: este movimiento compensa a otro (monto negativo). Un movimiento solo puede anularse una vez.
  reversalOfId String?       @unique
  reversalOf   CashMovement? @relation("CashMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   CashMovement? @relation("CashMovementReversal")
  motivo       String?

  fecha     DateTime   @default(now())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tallerId])
  @@index([tipo])
  @@index([categoria])
  @@index([fecha])
  @@map("cash_movements")
}

// ============================================================================
// FASE 6+ — Cierre de Caja Diaria
// ============================================================================

enum DailyCloseStatus {
  ABIERTO
  CERRADO
  REABIERTO
}

model DailyClose {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  fecha     DateTime
  estado    DailyCloseStatus @default(ABIERTO)

  saldoInicial Float   @default(0)
  totalIngresos Float  @default(0)
  totalEgresos Float   @default(0)
  saldoFinal Float     @default(0)

  notas     String?

  closedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tallerId, fecha])
  @@index([tallerId])
  @@map("daily_closes")
}

// ============================================================================
// FASE 6+ — Cuenta Corriente por Cliente
// ============================================================================

model ClientCredit {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  clientId  String     @unique
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  saldo     Float      @default(0)      // Saldo actual (positivo = a favor de cliente, negativo = debe)
  creditLimit Float?                    // Límite de crédito opcional

  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@unique([tallerId, clientId])
  @@index([tallerId])
  @@map("client_credits")
}

// ============================================================================
// FASE 7+ — Técnicos
// ============================================================================

model Technician {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  nombre    String
  email     String?
  telefono  String?
  especialidad String?
  activo    Boolean    @default(true)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tallerId])
  @@map("technicians")
}

// ============================================================================
// FASE 8+ — Costos Fijos y Variables
// ============================================================================

enum CostTypeEnum {
  FIJO
  VARIABLE
}

model Cost {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  tipo      CostTypeEnum
  categoria String     // MATERIA_PRIMA, MANO_OBRA, SERVICIOS, etc.
  descripcion String

  monto     Float
  mes       Int        // 1-12
  anio      Int

  workOrderId String?   // Opcional, si es costo de una orden específica

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tallerId])
  @@index([tipo])
  @@map("costs")
}

// ============================================================================
// FASE 7+ — Objetivos y Metas
// ============================================================================

enum GoalType {
  INGRESO_MENSUAL
  ORDENES_MENSUALES
  CLIENTES_NUEVOS
}

enum GoalStatus {
  EN_PROGRESO
  ALCANZADO
  NO_ALCANZADO
  CANCELADO
}

model Goal {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  tipo      GoalType
  objetivo  Float      // Valor objetivo
  alcanzado Float      @default(0)

  mes       Int        // 1-12
  anio      Int

  estado    GoalStatus @default(EN_PROGRESO)
  notas     String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tallerId, tipo, mes, anio])
  @@index([tallerId])
  @@map("goals")
}

// ============================================================================
// AUDITORÍA — Acciones Sensibles
// ============================================================================

enum AuditAction {
  // Presupuestos
  QUOTE_CREATED
  QUOTE_APPROVED
  QUOTE_REJECTED
  QUOTE_CONVERTED_TO_WORK_ORDER

  // Órdenes
  WORK_ORDER_CREATED
  WORK_ORDER_STATUS_CHANGED
  WORK_ORDER_COMPLETED
  WORK_ORDER_DELIVERED

  // Pagos
  PAYMENT_RECORDED
  PAYMENT_ANNULLED
  PAYMENT_UPDATED

  // Caja
  CASH_MOVEMENT_RECORDED
  DAILY_CLOSE_CLOSED
  DAILY_CLOSE_REOPENED

  // Otras
  CLIENT_CREDIT_UPDATED
  SCHEDULE_STATUS_CHANGED

  // Stock
  PRODUCT_CREATED
  PRODUCT_UPDATED
  STOCK_PURCHASED
  STOCK_ADJUSTED
  STOCK_CONSUMED
  STOCK_RETURNED
  STOCK_POLICY_CHANGED
}

model AuditLog {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  // Usuario autenticado que ejecutó la acción (siempre derivado de la sesión del servidor). Null en registros históricos.
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  accion    AuditAction
  entityType String     // QUOTE, WORK_ORDER, PAYMENT, CASH_MOVEMENT, etc.
  entityId  String

  oldValue  String?    // JSON string del valor anterior
  newValue  String?    // JSON string del valor nuevo

  descripcion String?

  timestamp DateTime   @default(now())
  createdAt DateTime   @default(now())

  @@index([tallerId])
  @@index([timestamp])
  @@index([entityType])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================================================
// STOCK — Productos (repuestos e insumos) y libro de movimientos
// ============================================================================

enum ProductUnit {
  UNIDAD
  LITRO
  KILO
  METRO
  JUEGO
  PAR
}

enum StockMovementType {
  ENTRADA_COMPRA  // Compra / ingreso de mercadería (cantidad > 0)
  SALIDA_ORDEN    // Consumo por una orden de trabajo (cantidad < 0, requiere orden)
  AJUSTE          // Corrección manual con motivo (cantidad con signo)
  DEVOLUCION      // Devolución explícita de una orden (cantidad > 0, requiere orden y motivo)
  ANULACION       // Reservado para anular un movimiento puntual (sin uso en esta etapa)
}

model Product {
  id        String     @id @default(cuid())
  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Restrict)

  nombre    String
  sku       String?    // Único por taller cuando está cargado
  categoria String?
  unidad    ProductUnit @default(UNIDAD)

  costo       Float    @default(0)
  precioVenta Float    @default(0)

  // Valor derivado: solo lo modifica el trigger de stock_movements (nunca la aplicación directamente)
  stockActual Decimal  @default(0) @db.Decimal(12, 3)
  stockMinimo Decimal  @default(0) @db.Decimal(12, 3)

  activo    Boolean    @default(true) // Los productos no se borran: se desactivan
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  movements     StockMovement[]
  quoteItems    QuoteItem[]
  workOrderItems WorkOrderItem[]

  @@unique([tallerId, sku])
  @@unique([id, tallerId]) // Destino de la clave foránea compuesta de stock_movements (impide cruzar talleres)
  @@index([tallerId, activo])
  @@index([tallerId, nombre])
  @@map("products")
}

// Libro de movimientos: fuente de verdad e inmutable (los triggers rechazan UPDATE y DELETE).
// Las correcciones se hacen siempre con un movimiento nuevo.
model StockMovement {
  id        String     @id @default(cuid())

  tallerId  String
  taller    Taller     @relation(fields: [tallerId], references: [id], onDelete: Restrict)

  productId String
  // Clave compuesta (productId, tallerId): el producto debe pertenecer al mismo taller que el movimiento
  product   Product    @relation(fields: [productId, tallerId], references: [id, tallerId], onDelete: Restrict, onUpdate: Restrict)

  workOrderId String?
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  tipo      StockMovementType
  cantidad  Decimal    @db.Decimal(12, 3) // Con signo: entra (+) o sale (-)
  costoUnitario Float?
  motivo    String?

  // Stock del producto inmediatamente después de este movimiento (lo completa el trigger)
  stockResultante Decimal @default(0) @db.Decimal(12, 3)

  userId    String     // Usuario autenticado que ejecutó la operación (siempre de la sesión del servidor)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  createdAt DateTime   @default(now())

  @@index([tallerId, productId, createdAt])
  @@index([workOrderId, productId])
  @@index([userId])
  @@map("stock_movements")
}

// ============================================================================
// ÍNDICES PARA PERFORMANCE
// ============================================================================

// Ya hay índices automáticos en @id y @unique
// Los índices específicos están agregados en cada modelo

// Sesiones (JWT) cerradas con logout: se consulta por jti para que un token ya emitido no pueda reutilizarse.
model RevokedSession {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_sessions")
}
