{
  "name": "taller-mecanico-app",
  "version": "0.1.0",
  "description": "Sistema de gestión para talleres mecánicos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "qa:check": "node scripts/qa/run-qa.mjs --check",
    "qa:pin": "node scripts/qa/run-qa.mjs --pin",
    "qa:prisma": "node scripts/qa/run-qa.mjs -- prisma",
    "qa:dev": "node scripts/qa/run-qa.mjs -- next dev -p 3002",
    "qa:test": "node scripts/qa/run-qa.mjs -- vitest run",
    "qa:exec": "node scripts/qa/run-qa.mjs --",
    "qa:test:integration": "node scripts/qa/run-qa.mjs -- vitest run --config vitest.integration.config.ts",
    "qa:seed": "node scripts/qa/run-qa.mjs -- node scripts/qa/seed-baseline.mjs",
    "qa:e2e:compat": "node scripts/qa/run-qa.mjs -- node scripts/qa/e2e-compat.mjs",
    "qa:e2e:stock": "node scripts/qa/run-qa.mjs -- node scripts/qa/e2e-stock.mjs",
    "qa:db:checks": "node scripts/qa/run-qa.mjs -- node scripts/qa/db-checks.mjs",
    "qa:verify:migrations": "node scripts/qa/run-qa.mjs -- node scripts/qa/verify-migrations.mjs",
    "qa:fingerprint": "node scripts/qa/run-qa.mjs -- node scripts/qa/fingerprint.mjs",
    "qa:lock-probe": "node scripts/qa/run-qa.mjs -- node scripts/qa/lock-probe.mjs",
    "qa:serve-head": "node scripts/qa/run-qa.mjs -- node scripts/qa/serve-head.mjs",
    "qa:e2e:accounts": "node scripts/qa/run-qa.mjs -- node scripts/qa/e2e-accounts.mjs",
    "accounts:provision": "node scripts/accounts/provision.mjs",
    "accounts:seed-demo": "node scripts/accounts/seed-demo.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^6.0.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^1.39.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.20",
    "prisma": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.48.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^15.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
