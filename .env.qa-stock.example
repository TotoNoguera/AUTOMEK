# Entorno de QA de AUTOMEK (proyecto Neon independiente "AUTOMEK-QA").
# Copiar a .env.qa-stock (ignorado por git) y completar. NUNCA poner acá datos de producción.
#
# Dónde obtener las cadenas: Neon Console -> proyecto AUTOMEK-QA -> botón "Connect".
#   * Branch: la principal del proyecto QA. Base y rol: los que Neon propone por defecto.
#   * DATABASE_URL        -> desactivar "Connection pooling" y copiar la cadena (host SIN "-pooler").
#   * DATABASE_URL_POOLED -> activar "Connection pooling" y copiar la cadena (host CON "-pooler"). Opcional.

AUTOMEK_ENV=qa

# Conexión directa (migraciones, pruebas de concurrencia, aplicación contra QA)
DATABASE_URL=

# Conexión con pooler (opcional: para repetir las pruebas por el mismo camino que usa producción)
DATABASE_URL_POOLED=

# Se completa solo con: npm run qa:pin
AUTOMEK_QA_ENDPOINT=

# Versión mayor de PostgreSQL de producción (para que qa:check avise si QA difiere)
AUTOMEK_QA_PG_MAJOR=18

# Secreto propio de QA: debe ser distinto al de producción (así una sesión de QA no vale en producción)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002
